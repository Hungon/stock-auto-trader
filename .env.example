# Alpaca API keys — https://app.alpaca.markets/
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

# Free accounts: iex | Paid SIP: sip
ALPACA_DATA_FEED=iex

# live = https://api.alpaca.markets | paper = https://paper-api.alpaca.markets
ALPACA_BASE_URL=https://api.alpaca.markets

# Must be "live" or "paper" — must match ALPACA_BASE_URL
TRADING_MODE=live

# Set to "yes" to allow order submission (extra guard for live accounts)
LIVE_TRADING_CONFIRMED=no

# Market: auto (detect .T = Japan), us, or jp
# Display: auto (match market), usd, or jpy
DISPLAY_CURRENCY=auto
# Optional fixed USD/JPY rate for cross-currency display (recommended if FX fetch is slow)
FX_USDJPY=150.0

MARKET=jp

# Symbol — Japan examples: 7203.T (Toyota), 6758.T (Sony), or just 7203
# US examples: SPY (S&P 500 ETF), AAPL, MSFT
SYMBOL=7203.T
FAST_SMA_PERIOD=10
SLOW_SMA_PERIOD=30
BAR_TIMEFRAME=1Day
LOOKBACK_BARS=120

# Risk limits
MAX_ORDER_NOTIONAL=500
MAX_POSITION_SHARES=10
POLL_INTERVAL_SECONDS=60

# Chart UI: full refresh interval (seconds); ticks poll at half this rate
CHART_REFRESH_SECONDS=15

# Backtest defaults (US uses BACKTEST_INITIAL_CASH; Japan auto-uses ¥1M if cash <= 50000)
BACKTEST_INITIAL_CASH=10000
# Optional Japan overrides (yen):
# BACKTEST_INITIAL_CASH_JPY=1000000
# BACKTEST_MAX_ORDER_NOTIONAL_JPY=500000
