# Alpaca API keys — https://app.alpaca.markets/
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

# Free accounts: iex | Paid SIP: sip
ALPACA_DATA_FEED=iex

# live = https://api.alpaca.markets | paper = https://paper-api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Must be "live" or "paper" — must match ALPACA_BASE_URL
TRADING_MODE=paper

# Set to "yes" to allow order submission (extra guard for live accounts)
LIVE_TRADING_CONFIRMED=no

# Market: auto (detect .T = Japan), us, or jp
# Display: auto (match market), usd, or jpy
DISPLAY_CURRENCY=auto
# Optional fixed USD/JPY rate for cross-currency display (recommended if FX fetch is slow)
FX_USDJPY=150.0

MARKET=us

# Symbol — Japan examples: 7203.T (Toyota), 6758.T (Sony), or just 7203
# US examples: SPY (S&P 500 ETF), AAPL, MSFT
SYMBOL=SPY
FAST_SMA_PERIOD=10
SLOW_SMA_PERIOD=30
BAR_TIMEFRAME=1Day
LOOKBACK_BARS=120

# Risk limits
MAX_ORDER_NOTIONAL=500
MAX_POSITION_SHARES=10
POLL_INTERVAL_SECONDS=60
KILL_SWITCH_PATH=.kill_switch

# Daily loss limit (0 = disabled)
MAX_DAILY_LOSS_USD=0
MAX_DAILY_LOSS_PCT=0
# block_orders | kill_switch | liquidate
DAILY_LOSS_ACTION=block_orders

# Portfolio max drawdown (0 = disabled)
MAX_PORTFOLIO_DRAWDOWN_PCT=0
# block_orders | kill_switch | liquidate
DRAWDOWN_ACTION=kill_switch
RISK_STATE_PATH=./data/runtime/risk_state.json

# Stale data protection
# MAX_DATA_AGE_SECONDS=0 uses auto defaults by timeframe
MAX_DATA_AGE_SECONDS=0
MAX_DAILY_BAR_AGE_DAYS=3

# Market hours validation
REQUIRE_MARKET_OPEN=true
ALLOW_PREMARKET=false
ALLOW_AFTERHOURS=false
NO_TRADE_FIRST_MINUTES=0
NO_TRADE_LAST_MINUTES=0

# Backtest realism
BACKTEST_SLIPPAGE_BPS=0
BACKTEST_COMMISSION_PER_TRADE=0
BACKTEST_COMMISSION_BPS=0
# same_close | next_open | next_close
BACKTEST_EXECUTION_MODE=next_open

# Logging: text | json
LOG_FORMAT=text
LOG_LEVEL=INFO
# LOG_FILE=./logs/trader.log

# Chart UI: full refresh interval (seconds); ticks poll at half this rate
CHART_REFRESH_SECONDS=15

# Backtest defaults (US uses BACKTEST_INITIAL_CASH; Japan auto-uses ¥1M if cash <= 50000)
BACKTEST_INITIAL_CASH=10000
# Optional Japan overrides (yen):
# BACKTEST_INITIAL_CASH_JPY=1000000
# BACKTEST_MAX_ORDER_NOTIONAL_JPY=500000
